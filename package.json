{
  "name": "dirework",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "dev:full": "bash scripts/dev.sh",
    "setup": "bash scripts/setup.sh",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "db:push": "turbo -F @dirework/db db:push",
    "db:studio": "turbo -F @dirework/db db:studio",
    "db:generate": "turbo -F @dirework/db db:generate",
    "db:migrate": "turbo -F @dirework/db db:migrate",
    "db:start": "turbo -F @dirework/db db:start",
    "db:watch": "turbo -F @dirework/db db:watch",
    "db:stop": "turbo -F @dirework/db db:stop",
    "db:down": "turbo -F @dirework/db db:down",
    "test": "turbo test"
  },
  "dependencies": {
    "@dirework/env": "workspace:*",
    "dotenv": "^17.2.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@dirework/config": "workspace:*",
    "@types/node": "^22.13.14",
    "turbo": "^2.6.3",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "packageManager": "bun@1.3.10"
}
