{
  "name": "dirework",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^5",
      "@cloudflare/workers-types": "^4.20260621.1",
      "hono": "^4.8.2",
      "@trpc/server": "^11.16.0",
      "@trpc/client": "^11.16.0",
      "better-auth": "1.6.22",
      "alchemy": "^0.91.2",
      "wrangler": "^4.103.0",
      "drizzle-orm": "^0.45.1",
      "drizzle-kit": "^0.31.8",
      "lucide-react": "^0.546.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.7",
      "react-dom": "^19.2.7",
      "sonner": "^2.0.7",
      "@tailwindcss/postcss": "^4.3.1",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.3.1",
      "vitest": "^4.0.18",
      "@biomejs/biome": "^2.5.6"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "clean": "turbo run clean && rm -rf .turbo",
    "dev:web": "turbo run dev:bare -F web",
    "db:generate": "turbo run db:generate -F @dirework/db",
    "tokens": "bun design-system/scripts/generate.ts",
    "deploy": "turbo run deploy -F @dirework/infra",
    "destroy": "turbo run destroy -F @dirework/infra"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@dirework/config": "workspace:*",
    "@types/node": "^22.13.14",
    "@vitest/coverage-v8": "^4.1.10",
    "turbo": "^2.6.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.3.10"
}
