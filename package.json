{
  "name": "dirework",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^5",
      "@cloudflare/workers-types": "^4.20260621.1",
      "hono": "^4.12.32",
      "@trpc/server": "^11.16.0",
      "@trpc/client": "^11.16.0",
      "better-auth": "1.6.25",
      "alchemy": "^0.93.12",
      "wrangler": "^4.115.0",
      "drizzle-orm": "^0.45.1",
      "drizzle-kit": "^0.31.8",
      "lucide-react": "^0.546.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.7",
      "@tailwindcss/postcss": "^4.3.3",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.3.3",
      "vitest": "^4.1.10",
      "@biomejs/biome": "^2.5.6"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "audit:dependencies": "bun audit --audit-level=high --ignore GHSA-mh99-v99m-4gvg",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "clean": "turbo run clean && rm -rf .turbo",
    "dev:web": "turbo run dev:bare -F web",
    "db:generate": "turbo run db:generate -F @dirework/db",
    "tokens": "bun design-system/scripts/generate.ts",
    "deploy": "turbo run deploy -F @dirework/infra",
    "destroy": "turbo run destroy -F @dirework/infra"
  },
  "overrides": {
    "defu": "6.1.7",
    "fast-xml-parser": "5.10.1",
    "js-yaml": "4.3.0",
    "picomatch": "4.0.5",
    "postcss": "8.5.25",
    "sharp": "0.35.3",
    "undici": "7.28.0",
    "vite": "8.2.0",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@cloudflare/workers-types": "^4.20260702.1",
    "brace-expansion": "2.1.2",
    "balanced-match": "1.0.2",
    "path-to-regexp": "8.4.2",
    "@dirework/config": "workspace:*",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.10",
    "turbo": "^2.10.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "bun@1.3.14",
  "patchedDependencies": {
    "brace-expansion@2.1.2": "patches/brace-expansion@2.1.2.patch"
  }
}
