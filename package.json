{
  "name": "dirework",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^18.0.7",
      "zod": "^4.4.3",
      "typescript": "^7.0.2",
      "@cloudflare/workers-types": "^5.20261012.1",
      "hono": "^4.13.7",
      "@trpc/server": "11.19.0",
      "@trpc/client": "11.19.0",
      "@trpc/tanstack-react-query": "11.19.0",
      "better-auth": "1.7.7",
      "alchemy": "^0.94.0",
      "wrangler": "^4.149.0",
      "drizzle-orm": "^0.45.1",
      "drizzle-kit": "^0.31.8",
      "lucide-react": "^1.56.0",
      "next-themes": "^0.4.6",
      "react": "^19.3.0",
      "react-dom": "^19.3.0",
      "sonner": "^2.0.7",
      "@tailwindcss/postcss": "^4.3.3",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "tailwindcss": "^4.3.3",
      "vitest": "^5.0.4",
      "sql.js": "^1.14.1",
      "@types/sql.js": "^1.4.11",
      "@biomejs/biome": "^2.5.15",
      "@types/node": "^22.20.1"
    },
    "catalogs": {
      "fumadocs": {
        "lucide-react": "^0.563.0"
      }
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "audit:dependencies": "bun audit --audit-level=high --ignore=GHSA-5j98-mcp5-4vw2",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "clean": "turbo run clean && rm -rf .turbo",
    "dev:web": "turbo run dev:bare -F web",
    "db:generate": "turbo run db:generate -F @dirework/db",
    "tokens": "bun design-system/scripts/generate.ts",
    "deploy": "bun run --cwd packages/infra deploy",
    "destroy": "bun run --cwd packages/infra destroy"
  },
  "overrides": {
    "defu": "6.1.7",
    "fast-xml-parser": "5.10.1",
    "image-size": "2.0.3",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.18",
    "picomatch": "4.0.5",
    "postcss": "8.5.25",
    "postcss-selector-parser": "7.1.6",
    "proxy-addr": "2.0.8",
    "qs": "6.16.0",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "undici": "7.29.1",
    "vite": "8.2.0",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "brace-expansion": "2.1.7",
    "path-to-regexp": "8.4.2",
    "@dirework/config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "^5.0.4",
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.3.14"
}
