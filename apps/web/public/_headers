# Workers static-assets headers (copied into .open-next/assets by the build).
# Without these, assets are served "max-age=0, must-revalidate" and every
# overlay/dashboard load revalidates each JS/CSS/font file before rendering.

# Content-hashed by Next: a changed file always gets a new URL.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts are NOT hashed (scripts/fetch-fonts.ts), so stay fresh for a
# day and then revalidate in the background instead of blocking the render.
/fonts/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000

# PWA, favicon and touch icons are not hashed: same fresh-for-a-day policy.
/icons/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000
  X-Content-Type-Options: nosniff

# The social share card (scripts/render-og.ts renders it at build): unhashed, same policy.
/og.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000

# Revalidate the deployed commit on each visible-tab check.
/version.json
  Cache-Control: no-cache
