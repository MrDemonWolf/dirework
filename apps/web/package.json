{
  "name": "web",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build --skipWranglerConfigCheck && node scripts/fix-duplicate-wasm-specifiers.mjs && opennextjs-cloudflare populateCache local",
    "start": "next start",
    "dev:bare": "next dev --port 3001 --hostname 127.0.0.1",
    "test": "vitest run",
    "check-types": "rm -rf .next/dev/types && SKIP_ENV_VALIDATION=true next typegen && tsc --noEmit",
    "clean": "rm -rf .next .open-next .turbo",
    "fetch-fonts": "bun scripts/fetch-fonts.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@dirework/api": "workspace:*",
    "@dirework/env": "workspace:*",
    "@dirework/overlay-kit": "workspace:*",
    "@opennextjs/cloudflare": "^1.20.2",
    "@tanstack/react-query": "^5.101.4",
    "@trpc/client": "catalog:",
    "@trpc/server": "catalog:",
    "@trpc/tanstack-react-query": "^11.16.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "better-auth": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "catalog:",
    "next": "^16.3.8",
    "next-themes": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sonner": "catalog:",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.3.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
