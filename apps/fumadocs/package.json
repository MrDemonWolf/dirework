{
  "name": "fumadocs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev --port=4000",
    "start": "wrangler pages dev out",
    "check-types": "rm -rf .next/dev/types && fumadocs-mdx && next typegen && tsc --noEmit",
    "clean": "rm -rf .next out .source .turbo",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "@dirework/overlay-kit": "workspace:*",
    "@orama/orama": "^3.1.18",
    "fumadocs-core": "16.5.1",
    "fumadocs-mdx": "14.2.6",
    "fumadocs-ui": "16.5.1",
    "lucide-react": "^0.563.0",
    "next": "16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/mdx": "^2.0.14",
    "@types/node": "^25.1.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "wrangler": "catalog:"
  }
}
