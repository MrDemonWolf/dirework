{
  "name": "fumadocs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "fumadocs-mdx && _FUMADOCS_MDX=1 next build",
    "dev": "next dev --port=4000",
    "start": "wrangler pages dev out",
    "check-types": "rm -rf .next/dev/types && fumadocs-mdx && _FUMADOCS_MDX=1 next typegen && tsc --noEmit",
    "clean": "rm -rf .next out .source .turbo",
    "postinstall": "fumadocs-mdx"
  },
  "dependencies": {
    "@dirework/fonts": "workspace:*",
    "@dirework/overlay-kit": "workspace:*",
    "fumadocs-core": "16.17.8",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "16.17.8",
    "lucide-react": "catalog:",
    "next": "16.4.2",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "catalog:",
    "@types/mdx": "^2.0.14",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "postcss": "^8.5.25",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
