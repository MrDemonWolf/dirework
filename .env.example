# Dirework — environment variables
# Local dev: copy to packages/infra/.env (Alchemy loads it, plus apps/web/.env + apps/server/.env).
# Production: set these as GitHub Actions secrets (see .github/workflows/deploy.yml)
# or in your shell before `bun run deploy`.

# Authentication (min 32 chars — generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=""

# Public URL of the WEB worker (the browser-facing origin).
# Local dev:
BETTER_AUTH_URL="http://localhost:3001"
# Production: BETTER_AUTH_URL="https://dirework.mrdemonwolf.workers.dev"

# CORS allowed origin (the web worker origin — same as BETTER_AUTH_URL)
CORS_ORIGIN="http://localhost:3001"

# Public URL of the API worker (the SERVER origin, port 3000 in dev — NOT the web
# origin). The web app's OAuth route handlers proxy to this, and publicTrpc hits
# it directly. Point it at the WEB origin by mistake and the proxy loops back on
# itself (dev-login and every /api/auth/* call return 500). Lives in apps/web/.env
# (NEXT_PUBLIC_* is baked at build — restart dev after changing).
# LOCAL DEV ONLY — in production Alchemy injects the api worker's resolved URL
# into both the web build and the runtime binding, so do NOT set this as a
# GitHub repository Variable: it would be ignored, and a stale value there just
# misleads you while debugging.
NEXT_PUBLIC_SERVER_URL="http://localhost:3000"

# Shared secret bound to BOTH workers (min 32 chars — openssl rand -base64 32).
# The web worker signs the browser's IP with it when proxying to the api worker,
# so the api rate limiter keys each client separately instead of lumping every
# proxied request under the web worker's own IP. REQUIRED for production deploys.
# Local dev: leave unset — `bun run dev` generates a fresh one per run.
# PROXY_SECRET=""

# Twitch OAuth — register at https://dev.twitch.tv/console/apps
# Redirect URLs to add (swap in your web origin):
#   <web-origin>/api/auth/callback/twitch   (streamer login)
#   <web-origin>/api/bot/callback/twitch    (bot account connect)
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""

# Cloudflare (deploy only)
# CLOUDFLARE_API_TOKEN=""   # Workers + D1 edit permissions
# ALCHEMY_PASSWORD=""       # encrypts Alchemy state secrets
# ALCHEMY_STATE_TOKEN=""  # CI only; the SHARED fleet token of the account-wide
#                         # alchemy-state store worker (min 32 chars). Every app deploying to
#                         # that store must use this same token — a per-app token against it
#                         # fails with "token is invalid". Keep it private.

# Optional production HTTPS pages
# DOCS_URL="https://docs.example.com"
# PRIVACY_POLICY_URL="https://app.example.com/privacy"
# TERMS_OF_SERVICE_URL="https://app.example.com/terms"
# Set to "true" during CI/build to skip runtime env validation.

# SKIP_ENV_VALIDATION="true"

# ── Dev bypass login ─────────────────────────────────────────────────────────
# LOCAL DEV ONLY — never set either of these in production.
# DEV_LOGIN registers the POST /api/auth/dev-login endpoint that mints an owner
# session without Twitch OAuth (server worker gate). NEXT_PUBLIC_DEV_LOGIN shows
# the matching "Dev bypass login" button in the web app (baked at build time).
# Leaving them unset/"false" keeps the endpoint unregistered and the button hidden.
# The endpoint also requires a per-run secret (the dev servers listen on every
# interface, so the flag alone would let anyone on your network sign in).
# `bun run dev` prints a fresh one each run; the button asks for it once per tab.
# Set DEV_LOGIN_SECRET to pin your own instead.
# DEV_LOGIN="true"
# NEXT_PUBLIC_DEV_LOGIN="true"
# DEV_LOGIN_SECRET=""
