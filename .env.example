# Database
# Local development (bun run setup / dev:full) — default, works out of the box:
DATABASE_URL="postgresql://postgres:password@localhost:5432/dirework"
# Docker Compose deployment — comment the line above, uncomment and edit below:
# DATABASE_URL="postgresql://dirework:CHANGE_ME@db:5432/dirework"

# Docker Compose — required only when deploying with docker-compose.yml
# Host must be "db" (compose service name); POSTGRES_PASSWORD must match DATABASE_URL
POSTGRES_USER="dirework"
POSTGRES_PASSWORD=""
POSTGRES_DB="dirework"

# Authentication (min 32 chars — generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=""

# Public URL of your Dirework instance
BETTER_AUTH_URL="http://localhost:3001"

# CORS allowed origin (usually same as BETTER_AUTH_URL)
CORS_ORIGIN="http://localhost:3001"

# Twitch OAuth — register at https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=""
TWITCH_CLIENT_SECRET=""

# Redis pub/sub event bus (optional). Leave unset for single-process deploys —
# events fall back to the in-process bus. Set when running multiple replicas
# (or app + bot in separate processes) so overlays stay in sync everywhere.
# Docker Compose / Dokploy compose default: redis://redis:6379
# REDIS_URL="redis://redis:6379"

# Documentation site URL (used by !dwhelp bot command to link viewers to the commands page)
# DOCS_URL="http://localhost:4000"

# Legal page URLs (set to show links in footer, leave empty to hide)
# PRIVACY_POLICY_URL="https://example.com/privacy"
# TERMS_OF_SERVICE_URL="https://example.com/terms"

# Environment
NODE_ENV="development"

# Set to "true" during CI/build to skip env validation
# SKIP_ENV_VALIDATION="true"
