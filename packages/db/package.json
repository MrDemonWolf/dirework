{
  "name": "@dirework/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./schema": {
      "default": "./src/schema/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@dirework/env": "workspace:*",
    "@paralleldrive/cuid2": "^2.2.2",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@dirework/config": "workspace:*",
    "@types/sql.js": "catalog:",
    "drizzle-kit": "catalog:",
    "sql.js": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
