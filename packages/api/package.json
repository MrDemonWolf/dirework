{
  "name": "@dirework/api",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    },
    "./*/*": {
      "default": "./src/*/*.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "check-types": "tsc --noEmit",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@dirework/auth": "workspace:*",
    "@dirework/db": "workspace:*",
    "@dirework/env": "workspace:*",
    "@trpc/server": "catalog:",
    "drizzle-orm": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@dirework/config": "workspace:*",
    "hono": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
