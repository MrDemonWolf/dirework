{
  "$schema": "https://json-schema.org/draft-07/schema",
  "meta": {
    "name": "DireWork Design System",
    "version": "2.0.0",
    "description": "Source of truth for the Focus Console UI palette (light + dark), the type, tracking, radius, motion and layout scale, and the overlay theme swatches. design-system/scripts/generate.ts renders it into apps/web/src/tokens.generated.css, apps/fumadocs/src/app/tokens.generated.css and the docs theme gallery module. Do not edit generated files; edit this file and run `bun run tokens`."
  },
