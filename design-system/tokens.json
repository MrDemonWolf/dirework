  "font": {
    "family": {
      "display": "Montserrat",
      "sans": "IBM Plex Sans",
      "mono": "IBM Plex Mono"
    },
    "size": {
      "3xs": 10,
      "2xs": 11,
      "xs": 12,
      "sm": 14,
      "base": 16,
      "lg": 18,
      "xl": 20,
      "2xl": 24,
      "3xl": 30,
      "4xl": 36,
      "5xl": 48,
      "6xl": 60,
      "7xl": 72,
      "8xl": 96,
      "9xl": 128
    },
    "lineHeight": {}
  },
  "tracking": {
    "chip": "0.08em",
    "label": "0.12em",
    "eyebrow": "0.18em",
    "display": "0.2em",
    "marquee": "0.3em"
  },
  "radius": {
    "xs": 4,
    "sm": 8,
    "md": 10,
    "lg": 12,
    "xl": 16,
    "2xl": 20,
    "3xl": 24,
    "4xl": 28
  },
  "motion": {
    "easing": {
      "console": "cubic-bezier(0.22, 1, 0.36, 1)"
    },
    "animation": {
      "console-rise": { "keyframes": "console-rise", "duration": 450, "easing": "console" },
      "console-rise-fast": { "keyframes": "console-rise", "duration": 200, "easing": "console" }
    }
  },
  "layout": {
    "container": {
      "content": "72rem",
      "editor": "380px"
    },
    "spacing": {
      "header": "3.5rem"
    }
  },
  "z": {
    "saveBar": 40,
    "header": 50,
    "skipLink": 60
  },
  "overlay": {
    "ringShape": "squircle",
    "squircleRadius": 0.22,
    "defaultTheme": "Default",
    "themes": {
      "Default": { "bg": "#091533", "accent": "#00ACED", "text": "#FFFFFF", "username": "#7F9CFF" },
      "Ocean Depths": {
        "bg": "#0A1628",
        "accent": "#2DD4BF",
        "text": "#E0F2FE",
        "username": "#2DD4BF"
      },
      "Liquid Glass Dark": {
        "bg": "#1C1C1E",
        "accent": "#0A84FF",
        "text": "#F5F5F7",
        "username": "#6DB3FF"
      },
      "Cozy Cottage": {
        "bg": "#FAF3E8",
        "accent": "#B8860B",
        "text": "#5C3D1A",
        "username": "#8A5A00"
      },
      "Minimal Light": {
        "bg": "#FFFFFF",
        "accent": "#6366F1",
        "text": "#111827",
        "username": "#4F46E5"
      },
      "Twitch Purple": {
        "bg": "#0E0E10",
        "accent": "#9146FF",
        "text": "#EFEFF1",
        "username": "#BF94FF"
      }
    }
  }
}
