{
  "$schema": "https://json-schema.org/draft-07/schema",
  "meta": {
    "name": "DireWork Design System",
    "version": "3.0.0",
    "description": "Source of truth for the neutral dark UI palette (light + dark), the type, tracking, radius, motion and layout scale, and the overlay theme swatches. design-system/scripts/generate.ts renders it into apps/web/src/tokens.generated.css, apps/fumadocs/src/app/tokens.generated.css and the docs theme gallery module. Do not edit generated files; edit this file and run `bun run tokens`."
  },
  "color": {
    "brand": {
      "500": "#1A66E0",
      "600": "#0B5CD5"
    },
    "brandDark": {
      "500": "#1F6FEB",
      "600": "#4493F8"
    },
    "semantic": {
      "success": "#34C759",
      "warning": "#FF9F0A",
      "error": "#FF453A"
    },
    "phase": {
      "work": "#34C759",
      "break": "#00ACED",
      "longBreak": "#6B8BF5",
      "paused": "#FF9F0A"
    },
    "partner": {
      "twitch": "#9146FF",
      "twitchHover": "#7C3AE6",
      "discord": "#5865F2",
      "obs": "#302E3B"
    },
    "console": {
      "base": "oklch(14.1% 0.005 285.823)",
      "line": "oklch(27.4% 0.006 286.033)",
      "edge": "oklch(37% 0.013 285.805)",
      "muted": "oklch(70.5% 0.015 286.067)",
      "soft": "oklch(87.1% 0.006 286.286)",
      "fg": "oklch(92% 0.004 286.32)",
      "bright": "oklch(96.7% 0.001 286.375)"
    },
    "scheme": {
      "light": {
        "background": "oklch(0.985 0 0)",
        "foreground": "oklch(0.21 0.006 286)",
        "card": "oklch(1 0 0)",
        "card-foreground": "oklch(0.21 0.006 286)",
        "popover": "oklch(1 0 0)",
        "popover-foreground": "oklch(0.21 0.006 286)",
        "primary": "oklch(0.54 0.2 260)",
        "primary-foreground": "oklch(1 0 0)",
        "link": "oklch(0.51 0.19 260)",
        "secondary": "oklch(0.955 0.002 286)",
        "secondary-foreground": "oklch(0.274 0.005 286)",
        "muted": "oklch(0.965 0.001 286)",
        "muted-foreground": "oklch(0.49 0.014 286)",
        "accent": "oklch(0.95 0.003 286)",
        "accent-foreground": "oklch(0.21 0.006 286)",
        "destructive": "oklch(0.55 0.205 25)",
        "success": "oklch(0.5 0.13 160)",
        "warning": "oklch(0.53 0.13 70)",
        "border": "oklch(0.21 0.006 286 / 14%)",
        "input": "oklch(0.21 0.006 286 / 24%)",
        "hairline": "oklch(0.21 0.006 286 / 10%)",
        "ring": "oklch(0.54 0.2 260)",
        "cornflower": "oklch(0.52 0.17 275)",
        "chart-1": "oklch(0.54 0.2 260)",
        "chart-2": "{cornflower}",
        "chart-3": "oklch(0.72 0.15 75)",
        "chart-4": "oklch(0.55 0.205 25)",
        "chart-5": "oklch(0.55 0.014 286)",
        "sidebar": "oklch(0.975 0.001 286)",
        "sidebar-foreground": "oklch(0.21 0.006 286)",
        "sidebar-primary": "oklch(0.54 0.2 260)",
        "sidebar-primary-foreground": "oklch(1 0 0)",
        "sidebar-accent": "oklch(0.95 0.003 286)",
        "sidebar-accent-foreground": "oklch(0.21 0.006 286)",
        "sidebar-border": "oklch(0.21 0.006 286 / 10%)",
        "sidebar-ring": "oklch(0.54 0.2 260)"
      },
      "dark": {
        "background": "oklch(0.155 0.004 286)",
        "foreground": "oklch(0.947 0.003 286)",
        "card": "oklch(0.197 0.006 286)",
        "card-foreground": "oklch(0.947 0.003 286)",
        "popover": "oklch(0.215 0.007 286)",
        "popover-foreground": "oklch(0.947 0.003 286)",
        "primary": "oklch(0.57 0.2 260)",
        "primary-foreground": "oklch(1 0 0)",
        "link": "oklch(0.68 0.16 256)",
        "secondary": "oklch(0.254 0.007 286)",
        "secondary-foreground": "oklch(0.92 0.004 286)",
        "muted": "oklch(0.232 0.008 286)",
        "muted-foreground": "oklch(0.712 0.013 286)",
        "accent": "oklch(0.271 0.009 286)",
        "accent-foreground": "oklch(0.947 0.003 286)",
        "destructive": "oklch(0.68 0.19 25)",
        "success": "oklch(0.76 0.15 160)",
        "warning": "oklch(0.82 0.15 80)",
        "border": "oklch(0.947 0.003 286 / 12%)",
        "input": "oklch(0.947 0.003 286 / 20%)",
        "hairline": "oklch(0.947 0.003 286 / 8%)",
        "ring": "oklch(0.68 0.16 256)",
        "cornflower": "oklch(0.72 0.13 275)",
        "chart-1": "oklch(0.68 0.16 256)",
        "chart-2": "{cornflower}",
        "chart-3": "oklch(0.82 0.15 80)",
        "chart-4": "oklch(0.68 0.19 25)",
        "chart-5": "oklch(0.712 0.013 286)",
        "sidebar": "oklch(0.17 0.006 286)",
        "sidebar-foreground": "oklch(0.947 0.003 286)",
        "sidebar-primary": "oklch(0.57 0.2 260)",
        "sidebar-primary-foreground": "oklch(1 0 0)",
        "sidebar-accent": "oklch(0.271 0.009 286)",
        "sidebar-accent-foreground": "oklch(0.947 0.003 286)",
        "sidebar-border": "oklch(0.947 0.003 286 / 8%)",
        "sidebar-ring": "oklch(0.68 0.16 256)"
      }
    }
  },
  "font": {
    "family": {
      "display": "Montserrat",
      "sans": "IBM Plex Sans",
      "mono": "IBM Plex Mono"
    },
    "size": {
      "3xs": 10,
      "2xs": 11,
      "xs": 12,
      "sm": 14,
      "base": 16,
      "lg": 18,
      "xl": 20,
      "2xl": 24,
      "3xl": 30,
      "4xl": 36,
      "5xl": 48,
      "6xl": 60,
      "7xl": 72,
      "8xl": 96,
      "9xl": 128
    },
    "lineHeight": {}
  },
  "tracking": {
    "chip": "0.08em",
    "label": "0.12em",
    "eyebrow": "0.18em",
    "display": "0.2em",
    "marquee": "0.3em"
  },
  "radius": {
    "xs": 4,
    "sm": 8,
    "md": 10,
    "lg": 12,
    "xl": 16,
    "2xl": 20,
    "3xl": 24,
    "4xl": 28
  },
  "motion": {
    "easing": {
      "console": "cubic-bezier(0.22, 1, 0.36, 1)"
    },
    "animation": {
      "console-rise": { "keyframes": "console-rise", "duration": 450, "easing": "console" },
      "console-rise-fast": { "keyframes": "console-rise", "duration": 200, "easing": "console" }
    }
  },
  "layout": {
    "container": {
      "content": "72rem",
      "editor": "380px"
    },
    "spacing": {
      "header": "3.5rem"
    }
  },
  "z": {
    "saveBar": 40,
    "header": 50,
    "skipLink": 60
  },
  "overlay": {
    "ringShape": "squircle",
    "squircleRadius": 0.22,
    "defaultTheme": "Default",
    "themes": {
      "Default": { "bg": "#091533", "accent": "#00ACED", "text": "#FFFFFF", "username": "#7F9CFF" },
      "Ocean Depths": {
        "bg": "#0A1628",
        "accent": "#2DD4BF",
        "text": "#E0F2FE",
        "username": "#2DD4BF"
      },
      "Liquid Glass Dark": {
        "bg": "#1C1C1E",
        "accent": "#0A84FF",
        "text": "#F5F5F7",
        "username": "#6DB3FF"
      },
      "Cozy Cottage": {
        "bg": "#FAF3E8",
        "accent": "#B8860B",
        "text": "#5C3D1A",
        "username": "#8A5A00"
      },
      "Minimal Light": {
        "bg": "#FFFFFF",
        "accent": "#6366F1",
        "text": "#111827",
        "username": "#4F46E5"
      },
      "Twitch Purple": {
        "bg": "#0E0E10",
        "accent": "#9146FF",
        "text": "#EFEFF1",
        "username": "#BF94FF"
      }
    }
  }
}
