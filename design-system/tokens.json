{
  "$schema": "https://json-schema.org/draft-07/schema",
  "meta": {
    "name": "Dirework Design System",
    "version": "1.0.0",
    "description": "Canonical design tokens for Dirework. Source of truth — do not edit generated files."
  },
  "color": {
    "brand": {
      "50":  "#F1F0FE",
      "100": "#E4E1FD",
      "200": "#CBC4FB",
      "300": "#AA9FF8",
      "400": "#8B7CF6",
      "500": "#6E5AF5",
      "600": "#5B43E0",
      "700": "#4A35C2",
      "800": "#3B2C9C",
      "900": "#2E2576"
    },
    "brandDark": {
      "50":  "rgba(110,90,245,0.12)",
      "500": "#9385FB",
      "600": "#6E5AF5"
    },
    "semantic": {
      "success": "#34C759",
      "warning": "#FF9F0A",
      "error":   "#FF453A",
      "info":    "#6E5AF5"
    },
    "phase": {
      "work":      "#34C759",
      "break":     "#0A84FF",
      "longBreak": "#BF5AF2",
      "paused":    "#FF9F0A"
    },
    "surface": {
      "light": {
        "base":     "#FFFFFF",
        "surface":  "#F4F3F8",
        "elev":     "#FBFAFE",
        "hairline": "#E5E2EF"
      },
      "dark": {
        "base":     "#0E0B16",
        "surface":  "#171221",
        "elev":     "#120E1B",
        "hairline": "#2A2438"
      }
    },
    "text": {
      "light": {
        "primary":   "#1A1523",
        "secondary": "#6B6577",
        "muted":     "#9C97A8"
      },
      "dark": {
        "primary":   "#F5F3FF",
        "secondary": "#A8A2B8",
        "muted":     "#6B6577"
      }
    },
    "partner": {
      "twitch":      "#9146FF",
      "twitchDark":  "#772CE8",
      "discord":     "#5865F2",
      "obs":         "#302E3B"
    }
  },
  "font": {
    "family": {
      "display": "Montserrat, -apple-system, BlinkMacSystemFont, system-ui, sans-serif",
      "sans":    "Roboto, -apple-system, BlinkMacSystemFont, system-ui, sans-serif",
      "mono":    "\"JetBrains Mono\", ui-monospace, \"SF Mono\", Menlo, Consolas, monospace"
    },
    "size": {
      "xs":   12,
      "sm":   13,
      "base": 14,
      "md":   16,
      "lg":   18,
      "xl":   20,
      "2xl":  24,
      "3xl":  30,
      "4xl":  36,
      "5xl":  48,
      "6xl":  60
    },
    "weight": {
      "regular":  400,
      "medium":   500,
      "semibold": 600,
      "bold":     700,
      "extrabold": 800
    }
  },
  "space": {
    "0": 2,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "7": 32,
    "8": 40,
    "9": 48,
    "10": 64,
    "11": 80
  },
  "radius": {
    "xs":   6,
    "sm":   8,
    "md":   12,
    "lg":   16,
    "xl":   20,
    "2xl":  24,
    "pill": 9999
  },
  "motion": {
    "duration": {
      "instant": 0,
      "fast":    150,
      "base":    220,
      "slow":    320,
      "long":    500
    },
    "easing": {
      "standard":   "cubic-bezier(0.4, 0.0, 0.2, 1)",
      "emphasized": "cubic-bezier(0.2, 0.0, 0, 1)"
    }
  },
  "shadow": {
    "xs":   "0 1px 2px rgba(26,21,35,0.08)",
    "sm":   "0 2px 6px rgba(26,21,35,0.10)",
    "md":   "0 8px 24px -8px rgba(26,21,35,0.18)",
    "lg":   "0 24px 60px -28px rgba(26,21,35,0.35)",
    "glow": "0 0 24px rgba(110,90,245,0.30)"
  },
  "overlay": {
    "ringShape": "squircle",
    "squircleRadius": 0.22,
    "defaultTheme": "Default",
    "themes": {
      "Default":        { "bg": "#091533", "accent": "#00ACED", "text": "#FFFFFF", "username": "#6B8BF5" },
      "Ocean Depths":   { "bg": "#0A1628", "accent": "#2DD4BF", "text": "#E0F2FE", "username": "#2DD4BF" },
      "Liquid Glass Dark": { "bg": "#1C1C1E", "accent": "#0A84FF", "text": "#F5F5F7", "username": "#0A84FF" },
      "Cozy Cottage":   { "bg": "#FAF3E8", "accent": "#B8860B", "text": "#5C3D1A", "username": "#B8860B" },
      "Minimal Light":  { "bg": "#FFFFFF", "accent": "#6366F1", "text": "#111827", "username": "#6366F1" },
      "Twitch Purple":  { "bg": "#0E0E10", "accent": "#9146FF", "text": "#EFEFF1", "username": "#BF94FF" }
    }
  }
}
